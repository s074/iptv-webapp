    "@mui/material": "^9.4.0",
    "@reduxjs/toolkit": "^2.10.1",
    "idb-keyval": "^6.2.1",
    "query-string": "^9.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.13",
    "video.js": "^8.23.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.1",
